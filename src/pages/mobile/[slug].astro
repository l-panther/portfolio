---
import { getAllMobile } from '../../utils/projects';
import Layout from '../../layouts/Layout.astro';
import '../../styles/global-case-study.css';

import Header from '../../components/mobile/Header.astro';
import Hero from '../../components/mobile/Hero.astro';
import Problem from '../../components/mobile/Problem.astro';
import Features from '../../components/mobile/Features.astro';
import Outcome from '../../components/mobile/Outcome.astro';
import ProjectLinks from '../../components/mobile/ProjectLinks.astro';
import Footer from '../../components/mobile/Footer.astro';

import type { Mobile } from '../../types/mobile';

export function getStaticPaths() {
  const mobile = getAllMobile();

  return mobile
    .filter((project) => project.slug)
    .map((project) => ({
      params: { slug: project.slug },
      props: { project }
    }));
}

const { project } = Astro.props as {
  project: Mobile;
};

const allProjects = getAllMobile();

const currentIndex = allProjects.findIndex(
  (mobile) => mobile.slug === project.slug
);

const prevProject =
  currentIndex > 0
    ? allProjects[currentIndex - 1]
    : null;

const nextProject =
  currentIndex < allProjects.length - 1
    ? allProjects[currentIndex + 1]
    : null;
---

<Layout
  title={`${project.title} — Mobile Case Study`}
  description={project.description}
>
  <Header project={project} />
  <Hero project={project} />
  <Problem project={project} />
  <Features project={project} />
  <Outcome project={project} />
  <ProjectLinks
    prevMobile={prevProject}
    nextMobile={nextProject}
  />
  <Footer project={project} />
</Layout>
