
---
import mobile from '../../data/mobile.json';
import type { MobileProject } from '../../types/mobile';

import Header from '../../components/mobile/Header.astro';
import Hero from '../../components/mobile/Hero.astro';
import Overview from '../../components/mobile/Overview.astro';
import Features from '../../components/mobile/Features.astro';
import Screens from '../../components/mobile/Screens.astro';
import Outcome from '../../components/mobile/Outcome.astro';

import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
  return (mobile as MobileProject[]).map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props as {
  project: MobileProject;
};
---

<Layout title={`${project.title} | Mobile App Case Study`}>
  <main class="mobile-case-study">

    <Header />

    <Hero project={project} />

    <Overview project={project} />

    <Features project={project} />

    <Screens project={project} />

    <Outcome project={project} />

  </main>
</Layout>

