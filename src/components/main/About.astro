---
import { COMPANY_NAME} from '../../lib/config.js';
---

<!-- About me -->
<section class="about" id="about">
  <div class="about-grid">
    <div class="reveal left">
      <span class="eyebrow">Behind the Work</span>
    
      <h2>A little bit <span class="glow-blue">About me</span></h2>
    
      <p>
        My interest in creativity extends beyond the screen. As a
        <strong>painting and decorating professional</strong>,
        I work with colour, texture, and composition to transform interior
        spaces, taking pride in achieving clean, precise finishes that
        bring character to every project.
      </p>
    
      <p>
        Outside of my professional work, I channel that same creative
        interest into <strong>web development, 3D modelling, and visual design</strong>.
        I enjoy exploring new techniques, experimenting with ideas, and
        combining technical skills with artistic expression to produce
        work that is both functional and visually engaging.
      </p>
    
      <p>
        I'm naturally curious and enjoy learning new skills, exploring
        different techniques, and challenging myself creatively.
        Alongside my digital projects, I continue to take pride in my
        work as a painter and decorator, where I apply that same
        dedication to producing quality results.
      </p>
    
      <a
        href="https://l-panther.github.io/painter-decorator/"
        class="portfolio-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="portfolio-link-icon" aria-hidden="true">✦</span>
        <span>Painting & Decorating Portfolio</span>
        <span class="portfolio-link-arrow" aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="about-photo reveal right" style="--d:.1s">
      <img
        src={`${import.meta.env.BASE_URL}assets/images/main/about-desktop.png`}
        alt="Creative workspace representing web development, visual design and painting"
        loading="lazy"
        decoding="async"
      >
    </div>
  </div>
</section>

