---
import { COMPANY_NAME} from '../../lib/config.js';
---

<!-- About me -->
<section class="about" id="about">
  <div class="about-grid">
    <div class="reveal left">
      <span class="eyebrow">Behind the Work</span>

      <h2>A little bit <span class="glow-blue">About me</span></h2>

      <p>
        By day, I work as a <strong>painting and decorating professional</strong>,
        transforming interior spaces through colour, texture, and careful attention
        to detail. I take pride in creating <strong>clean, precise finishes</strong>
        that shape the character of a space and improve how it looks and feels.
      </p>

      <p>
        Beyond my professional work, I explore creativity through <strong>3D modelling, web development, and visual design</strong>.
        I enjoy turning ideas into tangible experiences—from responsive websites
        and interactive interfaces to digital artwork and rendered 3D concepts.
      </p>

      <p>
        Although these disciplines may seem different, they’re connected by the
        same approach: <strong>thoughtful design, strong composition, and attention
        to detail</strong>, with a desire to create work that feels considered and
        purposeful—whether it exists on a wall or a screen.
      </p>
    </div>

    <div class="about-photo reveal right" style="--d:.1s">
      <picture>
        <source
          media="(max-width: 860px)"
          srcset=src={`${import.meta.env.BASE_URL}assets/images/main/about-mobile.png`}
        >

        <img
          src={`${import.meta.env.BASE_URL}assets/images/main/about-desktop.png`}
          alt="Creative workspace representing web development, visual design and painting"
          loading="lazy"
          decoding="async"
        >
      </picture>
    </div>
  </div>
</section>

