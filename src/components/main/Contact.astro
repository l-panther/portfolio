    <!--
    <form class="reveal right" style="--d:.1s" onsubmit="event.preventDefault(); this.reset(); const b=this.querySelector('.btn'); const t=b.textContent; b.textContent='Message Sent'; setTimeout(()=>b.textContent=t,2200);">
      <div class="field"><label>Name</label><input type="text" required placeholder=""></div>
      <div class="field"><label>Email</label><input type="email" required placeholder=""></div>
      <div class="field"><label>Message</label><textarea rows="3" required></textarea></div>
      <button type="submit" class="btn btn-fill">Send Message</button>
