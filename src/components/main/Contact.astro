    <form
      id="contactForm"
      class="reveal right"
      style="--d:.1s"
      novalidate
    >
    <div class="field">
  <label for="contactName">Name</label>

  <input
    id="contactName"
    name="name"
    type="text"
    minlength="2"
    maxlength="80"
    autocomplete="name"
    required
  >

  <small class="field-error" id="nameError"></small>
</div>

<div class="field">
  <label for="contactEmail">Email</label>

  <input
    id="contactEmail"
    name="email"
    type="email"
    maxlength="254"
    autocomplete="email"
    required
  >

  <small class="field-error" id="emailError"></small>
</div>

<div class="field">
  <label for="contactMessage">Message</label>

  <textarea
    id="contactMessage"
    name="message"
    rows="3"
    minlength="10"
    maxlength="2000"
    required
  ></textarea>

  <small class="field-error" id="messageError"></small>
</div>
    
      <!-- Honeypot: humans won't see this -->
      <div class="hp-field" aria-hidden="true">
        <label for="website">Website</label>
        <input
          id="website"
          name="website"
          type="text"
          tabindex="-1"
          autocomplete="off"
        >
      </div>
    
      <button type="submit" class="btn btn-fill">
        Send Message
      </button>
    
      <div
        id="formStatus"
        class="form-alert"
        role="status"
        aria-live="polite"
        hidden
      ></div>
    </form>
  </div>
</section>

<style>
.hp-field {
  position: absolute;
  left: -9999px;
  width: 1px;
  height: 1px;
  overflow: hidden;
}

.field-error {
  display: block;
  min-height: 18px;
  margin-top: 6px;
  font-size: 0.8rem;
  color: #ff7474;
}

.field input.invalid,
.field textarea.invalid {
  border-color: #ff7474;
}

/* =========================
   FORM STATUS
========================= */

.form-alert {
  display: flex;
  align-items: center;
  gap: 10px;

  margin-top: 16px;
  padding: 12px 14px;

  border-radius: 8px;
  font-size: 0.9rem;
  line-height: 1.4;

  opacity: 1;
  transition: opacity 0.3s ease;
}

.form-alert.success {
  color: #b8c66a;
  background: rgba(139, 152, 62, 0.1);
  border: 1px solid rgba(139, 152, 62, 0.45);
}

.form-alert.error {
  color: #ff8585;
  background: rgba(220, 53, 69, 0.1);
  border: 1px solid rgba(220, 53, 69, 0.4);
}

.form-alert.fade-out {
  opacity: 0;
}

.form-alert[hidden] {
  display: none;
}


/* =========================
   STATUS BADGE
========================= */

.status-icon {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 26px;
  height: 26px;

  flex: 0 0 26px;

  border-radius: 50%;

  color: #fff;
}

.status-icon.success-icon {
  background-color: #8b983e;
}

.status-icon.error-icon {
  background-color: #dc3545;
}

.status-icon svg {
  display: block;

  width: 17px;
  height: 17px;

  overflow: visible;
}


/* =========================
   FORM
========================= */

.hp-field {
  position: absolute;
  left: -9999px;
  width: 1px;
  height: 1px;
  overflow: hidden;
}

.field-error {
  display: block;
  min-height: 18px;
  margin-top: 6px;

  font-size: 0.8rem;
  color: #ff7474;
}

.field input.invalid,
.field textarea.invalid {
  border-color: #ff7474;
}

.btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* Error badge */
.status-icon.error-icon {
  background: #dc3545;
}

.form-alert.error {
  color: #ff8585;
  background: rgba(220, 53, 69, 0.1);
  border: 1px solid rgba(220, 53, 69, 0.4);
}

.status-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  width: 26px;
  height: 26px;
  min-width: 26px;

  border-radius: 50%;
  color: #fff;
}

.success-icon {
  background: #8b983e;
}

.error-icon {
  background: #dc3545;
}

