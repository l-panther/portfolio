    <form
      id="contactForm"
      class="reveal right"
      style="--d:.1s"
      novalidate
    >
    <div class="field">
  <label for="contactName">Name</label>

  <input
    id="contactName"
    name="name"
    type="text"
    minlength="2"
    maxlength="80"
    autocomplete="name"
    required
  >

  <small class="field-error" id="nameError"></small>
</div>

<div class="field">
  <label for="contactEmail">Email</label>

  <input
    id="contactEmail"
    name="email"
    type="email"
    maxlength="254"
    autocomplete="email"
    required
  >

  <small class="field-error" id="emailError"></small>
</div>

<div class="field">
  <label for="contactMessage">Message</label>

  <textarea
    id="contactMessage"
    name="message"
    rows="3"
    minlength="10"
    maxlength="2000"
    required
  ></textarea>

  <small class="field-error" id="messageError"></small>
</div>
    
      <!-- Honeypot: humans won't see this -->
      <div class="hp-field" aria-hidden="true">
        <label for="website">Website</label>
        <input
          id="website"
          name="website"
          type="text"
          tabindex="-1"
          autocomplete="off"
        >
      </div>
    
      <button type="submit" class="btn btn-fill">
        Send Message
      </button>
    
      <div
        id="formStatus"
        class="form-alert"
        role="status"
        aria-live="polite"
        hidden
      ></div>
    </form>
  </div>
</section>

<style>
.hp-field {
  position: absolute;
  left: -9999px;
  width: 1px;
  height: 1px;
  overflow: hidden;
}

.field-error {
  display: block;
  min-height: 18px;
  margin-top: 6px;
  font-size: 0.8rem;
  color: #ff7474;
}

.field input.invalid,
.field textarea.invalid {
  border-color: #ff7474;
}

.form-alert {
  margin-top: 16px;
  padding: 12px 14px;
  border-radius: 8px;
  font-size: 0.9rem;
  line-height: 1.4;
}

.form-alert.success {
  color: #b8c66a;
  background: rgba(139, 152, 62, 0.1);
  border: 1px solid rgba(139, 152, 62, 0.45);
}

.form-alert.error {
  color: #ff8585;
  background: rgba(255, 90, 90, 0.08);
  border: 1px solid rgba(255, 90, 90, 0.35);
}

.form-alert[hidden] {
  display: none;
}

.btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}
</style>

<!-- Form submit -->
 <script>
  const form = document.getElementById("contactForm");

  if (form) {
    const button = form.querySelector('button[type="submit"]');

    const nameInput = document.getElementById("contactName");
    const emailInput = document.getElementById("contactEmail");
    const messageInput = document.getElementById("contactMessage");

    const nameError = document.getElementById("nameError");
    const emailError = document.getElementById("emailError");
    const messageError = document.getElementById("messageError");

    const status = document.getElementById("formStatus");

    const GOOGLE_SCRIPT_URL =
    "https://script.google.com/macros/s/AKfycbwhKC5vS_91Zyq8TAfRLztYldCq5VJE5cUbZiBzOK7QMhOaEsLfzEi-t7mpYNnultBq_g/exec";

    function clearErrors() {
      nameError.textContent = "";
      emailError.textContent = "";
      messageError.textContent = "";

      nameInput.classList.remove("invalid");
      emailInput.classList.remove("invalid");
      messageInput.classList.remove("invalid");

      status.hidden = true;
    }

    function validateForm() {
      clearErrors();

      let valid = true;

      const name = nameInput.value.trim();
      const email = emailInput.value.trim();
      const message = messageInput.value.trim();

      if (name.length < 2) {
        nameError.textContent =
          "Please enter your name.";

        nameInput.classList.add("invalid");
        valid = false;
      }

      if (!email) {
        emailError.textContent =
          "Please enter your email address.";

        emailInput.classList.add("invalid");
        valid = false;

      } else if (!emailInput.validity.valid) {
        emailError.textContent =
          "Please enter a valid email address.";

        emailInput.classList.add("invalid");
        valid = false;
      }

      if (message.length < 10) {
        messageError.textContent =
          "Please enter at least 10 characters.";

        messageInput.classList.add("invalid");
        valid = false;
      }

      return valid;
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!validateForm()) {
        return;
      }

      const originalText = button.textContent;

      button.disabled = true;
      button.textContent = "Sending...";

      status.hidden = true;

      try {
        const formData = new FormData(form);

        await fetch(GOOGLE_SCRIPT_URL, {
          method: "POST",
          body: formData,
          mode: "no-cors"
        });

        form.reset();

        status.textContent =
          "✓ Thank you. Your message has been submitted.";

        status.className = "form-alert success";
        status.hidden = false;

        button.textContent = "Message Sent";

      } catch (error) {

        console.error("Contact form error:", error);

        status.textContent =
          "⚠ Sorry, your message couldn't be submitted. Please try again.";

        status.className = "form-alert error";
        status.hidden = false;

        button.textContent = originalText;
      }

      button.disabled = false;

      setTimeout(() => {
        button.textContent = originalText;
      }, 2200);
    });

    // Remove error as user corrects field
    [nameInput, emailInput, messageInput].forEach(input => {
      input.addEventListener("input", () => {
        input.classList.remove("invalid");

        const error =
          input.closest(".field")
            .querySelector(".field-error");

        error.textContent = "";
      });
    });
  }
</script>
