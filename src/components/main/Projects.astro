---
import websites from '../../data/websites.json';
import mobile from '../../data/mobile.json';

const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
---

<section class="projects" id="projects">
  <div class="wrap">

    <div class="sec-head">
      <span class="eyebrow">Selected Work</span>

      <h2 class="reveal">
        Featured <span class="glow-blue">Projects</span>
      </h2>

      <p class="reveal" style="--d:.06s">
        Explore my collection of responsive websites and
        interactive mobile applications, showcasing creative
        design, functionality and practical development.

        Each completed project includes a
        <strong>detailed case study</strong>
        covering the development process and final outcome.
      </p>
    </div>

    <div class="project-filters" role="group" aria-label="Project categories">
      <button
        type="button"
        class="project-filter active"
        data-filter="websites"
        aria-pressed="true"
      >
        <i class="bi bi-window" aria-hidden="true"></i>
        Websites
      </button>

      <button
        type="button"
        class="project-filter"
        data-filter="mobile"
        aria-pressed="false"
      >
        <i class="bi bi-phone" aria-hidden="true"></i>
        Mobile Apps
      </button>
    </div>

    <!-- WEBSITES -->
    <div class="project-panel" data-panel="websites">
      <div class="proj-grid">
        {websites.map((item) => (
          <div class="proj-card reveal" style={item.delay}>
            <a
              href={`${base}projects/${item.slug}`}
              class="project-link"
              data-direction="enter"
            >
              <div class="proj-thumb">
                <img
                  src={asset(`assets/images/projects/screenshots/${item.image}.webp`)}
                  alt={item.title}
                  loading="lazy"
                />
              </div>

              <h4>{item.title}</h4>
            </a>
          </div>
        ))}
      </div>

      {websites.length === 0 && (
        <p class="center-align">Website projects coming soon.</p>
      )}
    </div>

    <!-- MOBILE APPS -->
    <div class="project-panel" data-panel="mobile" hidden>
      {mobile.length > 0 ? (
        <div class="proj-grid mobile-grid">
          {mobile.map((item) => (
            <article class="proj-card mobile-card">
              <a
                href={`${base}mobile/${item.slug}`}
                class="project-link"
                data-direction="enter"
              >
                <div class="proj-thumb mobile-thumb">
                  <img
                    src={asset(`assets/images/projects/mobile/screenshots/${item.image}.webp`)}
                    alt={`${item.title} application preview`}
                    loading="lazy"
                  />
                </div>

                <h4>{item.title}</h4>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <div class="projects-empty">
          <div class="empty-icon">
            <i class="bi bi-phone" aria-hidden="true"></i>
          </div>

          <h3>Mobile Apps Coming Soon</h3>

          <p>
            I'm currently developing interactive learning
            applications. New projects and detailed case
            studies will be added here as they become available.
          </p>
        </div>
      )}
    </div>

  </div>
</section>

<style>
/* =========================================================
   PROJECTS
========================================================= */

.projects {
  background: linear-gradient(
    var(--bg),
    var(--bg-hero),
    var(--bg-hero),
    var(--bg)
  );
}

.proj-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
  max-width: 1180px;
  margin: 0 auto;
}

/* Project card */
.proj-card {
  min-width: 0;
  text-align: left;

  transition: transform 0.35s ease;
}

/* Screenshot */
.proj-thumb {
  position: relative;
  overflow: hidden;

  width: 100%;
  aspect-ratio: 4 / 3;

  margin: 0;

  background: #0c0f16;
  border: 1px solid var(--border-soft);
  border-bottom: none;
  border-radius: 5px 5px 0 0;
}

/* Display the complete screenshot */
.proj-thumb img {
  display: block;
  width: 100%;
  height: 100%;

  object-fit: contain;
  object-position: center;

  transition: transform 0.5s ease;
}

/* Integrated footer */
.proj-card h4 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;

  min-width: 0;
  min-height: 54px;

  margin: 0;
  padding: 14px 16px;

  background: rgba(107, 163, 214, 0.07);
  border: 1px solid var(--border-soft);
  border-radius: 0 0 5px 5px;

  color: var(--text-bright);
  font-size: 15px;
  font-weight: 600;
  line-height: 1.5;

  overflow-wrap: anywhere;

  transition:
    background 0.3s ease,
    border-color 0.3s ease;
}

/* Arrow */
.proj-card h4::after {
  content: "↗";

  flex-shrink: 0;
  align-self: center;

  color: #6ba3d6;
  font-size: 20px;
  font-weight: 400;
  line-height: 1;
}

/* Hover */
.proj-card:hover {
  transform: translateY(-6px);
}

.proj-card:hover .proj-thumb {
  border-color: var(--border);
}

.proj-card:hover .proj-thumb img {
  transform: scale(1.02);
}

.proj-card:hover h4 {
  background: rgba(107, 163, 214, 0.13);
  border-color: var(--border);
}

@media (min-width: 992px) {
  .projects-grid > :nth-last-child(2):nth-child(3n + 1) {
    grid-column: 1 / 2;
    transform: translateX(50%);
  }

  .projects-grid > :last-child:nth-child(3n + 2) {
    grid-column: 2 / 3;
    transform: translateX(50%);
  }
}

/* =========================================================
   TABLET
========================================================= */

@media (max-width: 900px) {
  .proj-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 520px) {
  .proj-grid {
    grid-template-columns: 1fr;
  }
}


/* ==========================================
   PROJECT FILTERS
========================================== */

.project-filters {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10px;

  margin: 0 auto 40px;
}

.project-filter {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 11px 22px;

  background: rgba(107, 163, 214, 0.05);
  border: 1px solid var(--border-soft);
  border-radius: 5px;

  color: var(--text-muted, #a5afc0);
  font: inherit;
  font-size: 13px;
  font-weight: 600;

  cursor: pointer;

  transition:
    background 0.25s ease,
    border-color 0.25s ease,
    color 0.25s ease;
}

.project-filter:hover {
  background: rgba(107, 163, 214, 0.12);
  border-color: #6ba3d6;
  color: var(--text-bright);
}

.project-filter.active {
  background: #6ba3d6;
  border-color: #6ba3d6;
  color: #08111f;
}

.project-filter:focus-visible {
  outline: 2px solid #6ba3d6;
  outline-offset: 3px;
}

/* ==========================================
   HIDDEN PROJECT CARDS
========================================== */

.proj-card[hidden] {
  display: none !important;
}

/* ==========================================
   EMPTY CATEGORY / COMING SOON
========================================== */

.projects-empty {
  max-width: 520px;
  margin: 20px auto 0;
  padding: 55px 30px;

  background: rgba(107, 163, 214, 0.04);
  border: 1px solid var(--border-soft);
  border-radius: 8px;

  text-align: center;
}

.projects-empty[hidden] {
  display: none !important;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 64px;
  height: 64px;
  margin: 0 auto 22px;

  background: rgba(107, 163, 214, 0.09);
  border: 1px solid rgba(107, 163, 214, 0.25);
  border-radius: 50%;

  color: #6ba3d6;
  font-size: 26px;
}

.projects-empty h3 {
  margin: 0 0 12px;

  color: var(--text-bright);
  font-size: 23px;
  font-weight: 700;
}

.projects-empty p {
  margin: 0;

  color: var(--text-muted, #a5afc0);
  font-size: 14px;
  line-height: 1.8;
}

/* ==========================================
   MOBILE
========================================== */

@media (max-width: 520px) {

  .project-filters {
    gap: 8px;
    margin-bottom: 30px;
  }

  .project-filter {
    padding: 10px 14px;
    font-size: 12px;
  }

  .projects-empty {
    padding: 40px 22px;
  }

  .projects-empty h3 {
    font-size: 20px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .project-filter {
    transition: none;
  }
}


/* ======================================
   CATEGORY FILTERS
====================================== */

.project-filters {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  margin: 0 auto 42px;
}

.project-filter {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;

  min-width: 155px;
  padding: 12px 24px;

  background: rgba(107, 163, 214, 0.06);
  border: 1px solid var(--border-soft);
  border-radius: 5px;

  color: #aebdd0;
  font: inherit;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;

  transition:
    background 0.25s ease,
    border-color 0.25s ease,
    color 0.25s ease;
}

.project-filter i {
  font-size: 16px;
  color: #6ba3d6;
}

.project-filter:hover {
  background: rgba(107, 163, 214, 0.12);
  border-color: #6ba3d6;
  color: var(--text-bright);
}

.project-filter.active {
  background: #6ba3d6;
  border-color: #6ba3d6;
  color: #08121f;
}

.project-filter.active i {
  color: inherit;
}

.project-filter:focus-visible {
  outline: 2px solid #6ba3d6;
  outline-offset: 3px;
}

.project-panel[hidden] {
  display: none !important;
}

/* ======================================
   MOBILE APP CARDS
====================================== */

.mobile-thumb {
  display: flex;
  align-items: center;
  justify-content: center;

  background: radial-gradient(
    ellipse at 50% 70%,
    rgba(107, 163, 214, 0.17),
    rgba(12, 15, 22, 0.96) 75%
  );
}

.mobile-thumb img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
}

/* ======================================
   COMING SOON
====================================== */

.projects-empty {
  max-width: 540px;
  margin: 0 auto;
  padding: 58px 32px;

  border: 1px solid var(--border-soft);
  border-radius: 5px;
  background: rgba(107, 163, 214, 0.04);

  text-align: center;
}

.empty-icon {
  display: grid;
  place-items: center;

  width: 65px;
  height: 65px;
  margin: 0 auto 22px;

  border-radius: 50%;
  background: rgba(107, 163, 214, 0.1);
  color: #6ba3d6;
  font-size: 27px;
}

.projects-empty h3 {
  margin: 0 0 12px;
  color: var(--text-bright);
  font-size: 23px;
}

.projects-empty p {
  max-width: 400px;
  margin: 0 auto;
  color: #aebdd0;
  font-size: 14px;
  line-height: 1.8;
}

@media (max-width: 520px) {
  .project-filters {
    gap: 10px;
    margin-bottom: 30px;
  }

  .project-filter {
    min-width: 0;
    padding: 11px 16px;
    font-size: 13px;
  }

  .projects-empty {
    padding: 42px 24px;
  }
}

</style>

<script>
  function initProjectFilters() {
    const section = document.querySelector('#projects');
    if (!section) return;

    const buttons = section.querySelectorAll<HTMLButtonElement>(
      '.project-filter'
    );

    const panels = section.querySelectorAll<HTMLElement>(
      '.project-panel'
    );

    buttons.forEach(button => {
      button.addEventListener('click', () => {
        const selected = button.dataset.filter;

        buttons.forEach(btn => {
          const active = btn === button;
          btn.classList.toggle('active', active);
          btn.setAttribute('aria-pressed', String(active));
        });

        panels.forEach(panel => {
          panel.hidden = panel.dataset.panel !== selected;
        });
      });
    });
  }

  initProjectFilters();

  document.addEventListener('astro:page-load', initProjectFilters);
</script>
