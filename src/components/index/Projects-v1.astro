
---
import websites from '../../data/websites.json';
import mobile from '../../data/mobile.json';

const base = import.meta.env.BASE_URL;

const asset = (path: string) =>
  `${base}${path.replace(/^\/+/, '')}`;

const websiteProjects = Array.isArray(websites) ? websites : [];
const mobileProjects = Array.isArray(mobile) ? mobile : [];

const INITIAL_COUNT = 4;

---

<section class="projects" id="projects">
  <div class="wrap">

    <!-- SECTION HEADING -->
    <div class="sec-head">
      <span class="eyebrow">Selected Work</span>

      <h2 class="reveal">
        Featured <span class="glow-blue">Projects</span>
      </h2>

      <p class="reveal" style="--d:.06s">
        Explore my collection of responsive websites and
        interactive mobile projects, showcasing creative
        design, functionality and practical development.

        Each completed project includes a
        <strong>detailed case study</strong>
        covering the development process and final outcome.
      </p>
    </div>

    <!-- FILTERS -->

    <div
      class="project-filters"
      role="group"
      aria-label="Project categories"
    >
      <button
        type="button"
        class="project-filter active"
        data-filter="websites"
        aria-pressed="true"
        aria-controls="projects-websites"
      >
        Websites

        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3" y="4" width="18" height="14" rx="2"/>
          <path d="M8 22h8M12 18v4"/>
        </svg>
      </button>

      <button
        type="button"
        class="project-filter"
        data-filter="mobile"
        aria-pressed="false"
        aria-controls="projects-mobile"
      >
        Mobile

        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="6" y="2" width="12" height="20" rx="2"/>
          <path d="M11 18h2"/>
        </svg>
      </button>
    </div>


    <!-- WEBSITE PROJECTS -->
    <div
      class="project-panel"
      id="projects-websites"
      data-panel="websites"
    >
      {websiteProjects.length > 0 ? (
        <>
          <div class="projects-list">

            {websiteProjects.map((item, index) => (
              <article
                class:list={[
                  'project-card',
                  { 'extra-project': index >= INITIAL_COUNT }
                ]}
                hidden={index >= INITIAL_COUNT}
              >

                <!-- SCREENSHOT -->
                <div class="project-visual">
                  <img
                    src={asset(
                      `assets/images/website/screenshots/${item.image}.webp`
                    )}
                    alt={`${item.title} website preview`}
                    loading="lazy"
                    decoding="async"
                  />
                </div>

                <!-- CONTENT -->
                <div class="project-content">

                  <span class="project-type">
                    Website Project
                  </span>

                  <h3>{item.title}</h3>

                  <p class="project-description">
                    {item.description}
                  </p>

                  <div class="project-actions">

                    <!-- LIVE WEBSITE -->
                    {item.link && item.link !== '#' && (
                      <a
                        href={item.link}
                        class="project-btn project-btn-primary"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        View Site

                        <svg
                          viewBox="0 0 24 24"
                          aria-hidden="true"
                        >
                          <path d="M7 17 17 7"/>
                          <path d="M8 7h9v9"/>
                        </svg>
                      </a>
                    )}

                    <!-- CASE STUDY -->
                                      
                    <a
                      href={`${base}website/${item.slug}`}
                      class="project-btn project-btn-outline"
                      data-direction="enter"
                    >
                      View Case Study

                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <path d="M14 2v6h6"/>
                        <path d="M8 13h8M8 17h8"/>
                      </svg>
                    </a>


                  </div>
                </div>

              </article>
            ))}

          </div>

          <!-- VIEW MORE -->
          {websiteProjects.length > INITIAL_COUNT && (
            <div class="projects-more">
              <button
                type="button"
                class="view-more-btn"
                aria-expanded="false"
                aria-controls="projects-websites"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="3" y="3" width="7" height="7" rx="1"/>
                  <rect x="14" y="3" width="7" height="7" rx="1"/>
                  <rect x="3" y="14" width="7" height="7" rx="1"/>
                  <rect x="14" y="14" width="7" height="7" rx="1"/>
                </svg>

                <span class="view-more-label">
                  View More Projects ({websiteProjects.length - INITIAL_COUNT})
                </span>

                <svg
                  class="more-chevron"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6"/>
                </svg>
              </button>
            </div>
          )}
        </>
      ) : (
        <div class="projects-empty">
          <div class="empty-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="4" width="18" height="14" rx="2"/>
              <path d="M8 22h8M12 18v4"/>
            </svg>
          </div>

          <h3>Website Projects Coming Soon</h3>
          <p>
            New website projects and detailed case
            studies will be added here soon.
          </p>
        </div>
      )}
    </div>

    <!-- MOBILE PROJECTS -->
    <div
      class="project-panel"
      id="projects-mobile"
      data-panel="mobile"
      hidden
    >
      {mobileProjects.length > 0 ? (
        <>
          <div class="projects-list mobile-list">

            {mobileProjects.map((item, index) => (
              <article
                class:list={[
                  'project-card',
                  'mobile-card',
                  { 'extra-project': index >= INITIAL_COUNT }
                ]}
                hidden={index >= INITIAL_COUNT}
              >

                <!-- MOBILE SCREENSHOT -->
                <div class="project-visual mobile-visual">
                  <img
                    src={asset(
                      `assets/images/mobile/screenshots/${item.image}.webp`
                    )}
                    alt={`${item.title} mobile preview`}
                    loading="lazy"
                    decoding="async"
                  />
                </div>

                <!-- CONTENT -->
                <div class="project-content">

                  <span class="project-type">
                    Mobile Project
                  </span>

                  <h3>{item.title}</h3>

                  <p class="project-description">
                    {item.description}
                  </p>

                  <div class="project-actions">

                    {item.link && item.link !== '#' && (
                      <a
                        href={item.link}
                        class="project-btn project-btn-primary"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        View Project

                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M7 17 17 7"/>
                          <path d="M8 7h9v9"/>
                        </svg>
                      </a>
                    )}
                                      
                    <a
                      href={`${base}mobile/${item.slug}`}
                      class="project-btn project-btn-outline"
                      data-direction="enter"
                    >
                      View Case Study

                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <path d="M14 2v6h6"/>
                        <path d="M8 13h8M8 17h8"/>
                      </svg>
                    </a>

                  </div>
                </div>

              </article>
            ))}

          </div>

          {mobileProjects.length > INITIAL_COUNT && (
            <div class="projects-more">
              <button
                type="button"
                class="view-more-btn"
                aria-expanded="false"
                aria-controls="projects-mobile"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="3" y="3" width="7" height="7" rx="1"/>
                  <rect x="14" y="3" width="7" height="7" rx="1"/>
                  <rect x="3" y="14" width="7" height="7" rx="1"/>
                  <rect x="14" y="14" width="7" height="7" rx="1"/>
                </svg>

                <span class="view-more-label">
                  View More Projects ({mobileProjects.length - INITIAL_COUNT})
                </span>

                <svg
                  class="more-chevron"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6"/>
                </svg>
              </button>
            </div>
          )}
        </>
      ) : (
        <div class="projects-empty">

          <div class="empty-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="6" y="2" width="12" height="20" rx="2"/>
              <path d="M11 18h2"/>
            </svg>
          </div>

          <h3>Mobile Projects Coming Soon</h3>

          <p>
            I'm currently developing interactive learning
            projects. New projects and detailed case
            studies will be added here as they become
            available.
          </p>

        </div>
      )}
    </div>

  </div>
</section>

<style>
/* ==========================================
   PROJECT SECTION
========================================== */

.projects {
  background: linear-gradient(
    var(--bg),
    var(--bg-hero),
    var(--bg-hero),
    var(--bg)
  );
}

/* ==========================================
   SVG ICONS
========================================== */

.projects svg {
  display: block;
  width: 17px;
  height: 17px;
  flex-shrink: 0;

  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

/* ==========================================
   FILTERS
========================================== */

.project-filters {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;

  margin: 0 auto 65px;
}

.project-filter {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;

  min-width: 155px;
  padding: 12px 24px;

  background: rgba(107, 163, 214, 0.06);
  border: 1px solid var(--border-soft);
  border-radius: 5px;

  color: #aebdd0;
  font: inherit;
  font-size: 14px;
  font-weight: 600;

  cursor: pointer;

  transition:
    background 0.25s ease,
    border-color 0.25s ease,
    color 0.25s ease;
}

.project-filter svg {
  color: #6ba3d6;
}

.project-filter:hover {
  background: rgba(107, 163, 214, 0.12);
  border-color: #6ba3d6;
  color: var(--text-bright);
}

.project-filter.active {
  background: #6ba3d6;
  border-color: #6ba3d6;
  color: #08121f;
}

.project-filter.active svg {
  color: inherit;
}

.project-filter:focus-visible,
.project-btn:focus-visible,
.view-more-btn:focus-visible {
  outline: 2px solid #6ba3d6;
  outline-offset: 4px;
}

.project-panel[hidden] {
  display: none !important;
}

/* ==========================================
   PROJECT LIST
========================================== */
/* -------------------------
   PROJECT CARDS
-------------------------- */

.projects-list {
  display: grid;
  gap: 32px;
}

/* ==========================================
   PROJECT CARD
========================================== */

.project-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  align-items: center;
  gap: clamp(32px, 5vw, 64px);

  padding: clamp(18px, 4vw, 18px);

  border-bottom: 1px solid rgba(107, 163, 214, 0.12);

  overflow: hidden;
}

.project-card[hidden] {
  display: none !important;
}

/* ==========================================
   ALTERNATING LAYOUT
========================================== */

/* Even rows: content left, screenshot right */
.project-card:nth-child(even) {
  grid-template-columns:
    minmax(0, 55fr)
    minmax(0, 45fr);
}

.project-card:nth-child(even) .project-visual {
  grid-column: 2;
  grid-row: 1;
}

.project-card:nth-child(even) .project-content {
  grid-column: 1;
  grid-row: 1;
}

/* ==========================================
   SCREENSHOTS
========================================== */

.project-visual {
  position: relative;

  width: 100%;
  min-width: 0;
  aspect-ratio: 4 / 3;

  overflow: hidden;

  transition: border-color 0.35s ease;
}

.project-visual img {
  display: block;
  width: 100%;
  height: 100%;

  object-fit: contain;
  object-position: center;

  transition: transform 0.5s ease;
}

.project-card:hover {
  border-color: #416b95;
}

.project-card:hover .project-visual img {
  transform: scale(1.025);
}

/* 3D perspective */
.project-visual {
  perspective: 1000px;
  min-width: 0;
}

/* Screenshot */
.project-visual img {
  display: block;
  width: 100%;
  height: auto;

  border: none;
  box-shadow: none;

  transform: rotateY(13deg);
  transform-origin: center;

  transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
}

/* Screenshots on the right */
.project-card:nth-child(even) .project-visual img {
  transform: rotateY(-13deg);
}

/* Return to front-facing */
.project-card:hover .project-visual img {
  transform: rotateY(0deg);
}
/* ==========================================
   PROJECT CONTENT
========================================== */

.project-content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;

  min-width: 0;
}

.project-type {
  display: inline-block;
  margin-bottom: 15px;

  color: #6ba3d6;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.project-content h3 {
  margin: 0 0 18px;

  color: var(--text-bright);
  font-size: clamp(25px, 3vw, 36px);
  font-weight: 700;
  line-height: 1.2;

  overflow-wrap: break-word;
}

.project-description {
  max-width: 48ch;
  margin: 0;

  color: var(--text-muted, #a5afc0);
  font-size: 15px;
  line-height: 1.8;
}

/* ==========================================
   CTA BUTTONS
========================================== */

.project-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;

  margin-top: 28px;
}

.project-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;

  min-height: 44px;
  padding: 12px 18px;

  border: 1px solid transparent;
  border-radius: 5px;

  font-size: 13px;
  font-weight: 600;
  line-height: 1.3;
  text-decoration: none;
  white-space: nowrap;

  transition:
    background 0.25s ease,
    border-color 0.25s ease,
    color 0.25s ease;
}

.project-btn svg {
  width: 16px;
  height: 16px;

  transition: transform 0.25s ease;
}

/* View Site */

.project-btn-primary {
  background: #6ba3d6;
  border-color: #6ba3d6;
  color: #08121f;
}

.project-btn-primary:hover {
  background: #89b9e2;
  border-color: #89b9e2;
  color: #08121f;
}

/* View Case Study */

.project-btn-outline {
  background: transparent;
  border-color: rgba(107, 163, 214, 0.5);
  color: #a9cceb;
}

.project-btn-outline:hover {
  background: rgba(107, 163, 214, 0.1);
  border-color: #6ba3d6;
  color: var(--text-bright);
}

.project-btn:hover svg {
  transform: translate(2px, -2px);
}

/* ==========================================
   MOBILE SCREENSHOTS
========================================== */

.mobile-visual {
  display: flex;
  align-items: center;
  justify-content: center;
}

.mobile-visual img {
  object-fit: contain;
  box-sizing: border-box;
}

/* ==========================================
   VIEW MORE
========================================== */

.projects-more {
  display: flex;
  justify-content: center;
  margin-top: 65px;
}

.view-more-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;

  padding: 14px 24px;

  background: rgba(107, 163, 214, 0.06);
  border: 1px solid rgba(107, 163, 214, 0.45);
  border-radius: 5px;

  color: #6ba3d6;
  font: inherit;
  font-size: 13px;
  font-weight: 600;

  cursor: pointer;

  transition:
    background 0.25s ease,
    border-color 0.25s ease,
    color 0.25s ease;
}

.view-more-btn:hover {
  background: rgba(107, 163, 214, 0.13);
  border-color: #6ba3d6;
  color: var(--text-bright);
}

.view-more-btn .more-chevron {
  transition: transform 0.25s ease;
}

.view-more-btn[aria-expanded="true"] .more-chevron {
  transform: rotate(180deg);
}

/* ==========================================
   COMING SOON
========================================== */

.projects-empty {
  max-width: 540px;
  margin: 0 auto;
  padding: 58px 32px;

  border: 1px solid var(--border-soft);
  border-radius: 5px;

  background: rgba(107, 163, 214, 0.04);
  text-align: center;
}

.empty-icon {
  display: grid;
  place-items: center;

  width: 65px;
  height: 65px;
  margin: 0 auto 22px;

  border-radius: 50%;
  background: rgba(107, 163, 214, 0.1);
  color: #6ba3d6;
}

.empty-icon svg {
  width: 27px;
  height: 27px;
}

.projects-empty h3 {
  margin: 0 0 12px;
  color: var(--text-bright);
  font-size: 23px;
  font-weight: 700;
}

.projects-empty p {
  max-width: 400px;
  margin: 0 auto;
  color: #aebdd0;
  font-size: 14px;
  line-height: 1.8;
}

/* ==========================================
   TABLET
========================================== */

@media (max-width: 991px) {
  .projects-list {
    gap: 70px;
  }

  .project-card {
    column-gap: 30px;
  }

  .project-content h3 {
    font-size: 27px;
    margin-bottom: 15px;
  }

  .project-description {
    font-size: 14px;
    line-height: 1.7;
  }

  .project-actions {
    gap: 10px;
    margin-top: 24px;
  }

  .project-btn {
    padding: 11px 14px;
    font-size: 12px;
  }
}

/* ==========================================
   MOBILE
========================================== */

@media (max-width: 767px) {
  .project-filters {
    margin-bottom: 45px;
  }

  .projects-list {
    gap: 60px;
  }

  .project-card,
  .project-card:nth-child(even) {
    grid-template-columns: minmax(0, 1fr);
    gap: 25px;
  }

  /* Screenshot always first */
  .project-card .project-visual,
  .project-card:nth-child(even) .project-visual {
    grid-column: 1;
    grid-row: 1;
  }

  .project-card .project-content,
  .project-card:nth-child(even) .project-content {
    grid-column: 1;
    grid-row: 2;
  }

  .project-content h3 {
    font-size: 27px;
  }

  .project-description {
    max-width: 100%;
  }

  .projects-more {
    margin-top: 45px;
  }
}

/* ==========================================
   SMALL MOBILE
========================================== */

@media (max-width: 520px) {
  .project-filters {
    gap: 10px;
    margin-bottom: 40px;
  }

  .project-filter {
    min-width: 0;
    padding: 11px 16px;
    font-size: 13px;
  }

  .projects-list {
    gap: 55px;
  }

  .project-content h3 {
    font-size: 25px;
  }

  .project-description {
    font-size: 14px;
  }

  .project-actions {
    gap: 10px;
  }

  .project-btn {
    padding: 11px 14px;
    font-size: 12px;
  }

  .projects-empty {
    padding: 42px 24px;
  }

  .view-more-btn {
    padding: 12px 18px;
    font-size: 12px;
  }
}

/* ==========================================
   REDUCED MOTION
========================================== */

@media (prefers-reduced-motion: reduce) {
  .project-filter,
  .project-visual,
  .project-visual img,
  .project-btn,
  .project-btn svg,
  .view-more-btn,
  .view-more-btn .more-chevron {
    transition: none;
  }
}
</style>

<script>
  function initProjects() {
    const section = document.querySelector<HTMLElement>('#projects');
    if (!section) return;

    /* CATEGORY FILTERS */

    const filters = section.querySelectorAll<HTMLButtonElement>(
      '.project-filter'
    );

    const panels = section.querySelectorAll<HTMLElement>(
      '.project-panel'
    );

    filters.forEach(button => {
      if (button.dataset.initialized === 'true') return;
      button.dataset.initialized = 'true';

      button.addEventListener('click', () => {
        const selected = button.dataset.filter;

        filters.forEach(filter => {
          const active = filter === button;

          filter.classList.toggle('active', active);
          filter.setAttribute('aria-pressed', String(active));
        });

        panels.forEach(panel => {
          panel.hidden = panel.dataset.panel !== selected;
        });
      });
    });

    /* VIEW MORE / SHOW LESS */

    const moreButtons = section.querySelectorAll<HTMLButtonElement>(
      '.view-more-btn'
    );

    moreButtons.forEach(button => {
      if (button.dataset.initialized === 'true') return;
      button.dataset.initialized = 'true';

      button.addEventListener('click', () => {
        const panel = button.closest('.project-panel');
        if (!panel) return;

        const extraCards = panel.querySelectorAll<HTMLElement>(
          '.extra-project'
        );

        const expanded =
          button.getAttribute('aria-expanded') === 'true';

        extraCards.forEach(card => {
          card.hidden = expanded;
        });

        button.setAttribute(
          'aria-expanded',
          String(!expanded)
        );

        const label = button.querySelector<HTMLElement>(
          '.view-more-label'
        );

        if (label) {
          label.textContent = expanded
            ? `View More Projects (${extraCards.length})`
            : 'Show Fewer Projects';
        }

        if (expanded) {
          const list = panel.querySelector('.projects-list');

          list?.scrollIntoView({
            behavior: 'auto',
            block: 'start'
          });
        }
      });
    });
  }

  initProjects();

  document.addEventListener(
    'astro:page-load',
    initProjects
  );
</script>
