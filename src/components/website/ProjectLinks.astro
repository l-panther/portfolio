---
import type { Website } from '../../types/website';

const base = import.meta.env.BASE_URL;

const {
  website,
  prevWebsite,
  nextWebsite,
} = Astro.props as {
  website: Website;
  prevWebsite: Website | null;
  nextWebsite: Website | null;
};
---

<section class="next-project">
  <div class="wrap">

    {prevWebsite && (
      <a
        href={`${base}website/${prevWebsite.slug}/`}
        class="next-link reveal"
        data-direction="prev"
      >
        <span>&larr;</span>
        {prevWebsite.title}
      </a>
    )}

    {nextWebsite && (
      <a
        href={`${base}website/${nextWebsite.slug}/`}
        class="next-link reveal"
        data-direction="next"
      >
        {nextWebsite.title}
        <span>&rarr;</span>
      </a>
    )}

  </div>
</section>