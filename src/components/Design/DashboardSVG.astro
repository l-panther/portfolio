<svg viewBox="0 0 560 460" xmlns="http://www.w3.org/2000/svg">
  <defs>
  <linearGradient id="dash-blue" x1="0" y1="0" x2="1" y2="1">
  <stop offset="0" stop-color="#3d6fca"/>
  <stop offset="1" stop-color="#274a8c"/>
  </linearGradient>

  <linearGradient id="dash-orange" x1="0" y1="0" x2="1" y2="1">
  <stop offset="0" stop-color="#e79a4a"/>
  <stop offset="1" stop-color="#c9762c"/>
  </linearGradient>

  <filter id="dash-soft" x="-40%" y="-40%" width="180%" height="180%">
  <feGaussianBlur stdDeviation="18"/>
  </filter>
  </defs>

  <!-- glow -->
  <ellipse
  cx="290"
  cy="230"
  rx="220"
  ry="180"
  fill="#3d6fca"
  opacity=".16"
  filter="url(#dash-soft)"
  />

  <!-- browser -->
  <rect x="60" y="52" width="440" height="324" rx="16"
    fill="#0e2140"
    stroke="rgba(255,255,255,.12)"/>

  <!-- topbar -->
  <rect x="60" y="52" width="440" height="40" rx="16" fill="#132a52"/>
  <rect x="60" y="72" width="440" height="20" fill="#132a52"/>

  <circle cx="84" cy="72" r="4.5" fill="#6b7aa0"/>
  <circle cx="100" cy="72" r="4.5" fill="#6b7aa0" opacity=".6"/>
  <circle cx="116" cy="72" r="4.5" fill="#6b7aa0" opacity=".6"/>

  <!-- sidebar -->
  <rect x="78" y="108" width="92" height="248" rx="10" fill="#132a52"/>

  <rect x="94" y="128" width="42" height="8" rx="4" fill="#3d6fca"/>

  <g fill="#6b7aa0">
  <rect x="94" y="158" width="56" height="6" rx="3"/>
  <rect x="94" y="184" width="44" height="6" rx="3"/>
  <rect x="94" y="210" width="52" height="6" rx="3"/>
  <rect x="94" y="236" width="38" height="6" rx="3"/>
  </g>

  <!-- stats -->
  <rect x="188" y="108" width="88" height="66" rx="9" fill="url(#dash-blue)"/>
  <rect x="286" y="108" width="88" height="66" rx="9" fill="#1b3560"/>
  <rect x="384" y="108" width="94" height="66" rx="9" fill="url(#dash-orange)"/>

  <!-- chart -->
  <rect x="188" y="188" width="190" height="94" rx="10" fill="#132a52"/>

  <polyline
  points="206,260 232,238 258,246 285,214 312,226 340,202 360,216"
  fill="none"
  stroke="#5b86d6"
  stroke-width="4"
  stroke-linecap="round"
  stroke-linejoin="round"
  />

  <!-- activity -->
  <rect x="390" y="188" width="88" height="168" rx="10" fill="#132a52"/>

  <g fill="#6b7aa0">
  <circle cx="408" cy="210" r="5"/>
  <rect x="420" y="207" width="42" height="6" rx="3"/>

  <circle cx="408" cy="238" r="5"/>
  <rect x="420" y="235" width="34" height="6" rx="3"/>

  <circle cx="408" cy="266" r="5"/>
  <rect x="420" y="263" width="46" height="6" rx="3"/>
  </g>

  <!-- table -->
  <rect x="188" y="296" width="190" height="60" rx="10" fill="#132a52"/>

  <g fill="#6b7aa0">
  <rect x="204" y="312" width="80" height="5" rx="2.5"/>
  <rect x="204" y="328" width="120" height="5" rx="2.5"/>
  <rect x="204" y="344" width="94" height="5" rx="2.5"/>
  </g>

  <!-- callouts -->
  <circle cx="236" cy="140" r="15"
      fill="#0e2140"
      stroke="#3d6fca"
      stroke-width="1.6"/>

  <text x="236" y="145"
    text-anchor="middle"
    font-family="Poppins"
    font-size="12"
    font-weight="700"
    fill="#fff">01</text>

  <circle cx="525" cy="232" r="15"
      fill="#0e2140"
      stroke="#3d6fca"
      stroke-width="1.6"/>

  <text x="525" y="237"
    text-anchor="middle"
    font-family="Poppins"
    font-size="12"
    font-weight="700"
    fill="#fff">02</text>

  <line x1="510" y1="232" x2="480" y2="232"
    stroke="rgba(255,255,255,.35)"
    stroke-width="1.4"
    stroke-dasharray="3 4"/>
</svg>