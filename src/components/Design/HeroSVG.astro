<svg viewBox="0 0 560 460" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="g1" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#3d6fca"/>
      <stop offset="1" stop-color="#274a8c"/>
    </linearGradient>
    <linearGradient id="g2" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#e79a4a"/>
      <stop offset="1" stop-color="#c9762c"/>
    </linearGradient>
    <linearGradient id="g3" x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" stop-color="#5b86d6"/>
      <stop offset="1" stop-color="#3d6fca"/>
    </linearGradient>
    <filter id="soft" x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur stdDeviation="18"/>
    </filter>
  </defs>

  <!-- ambient glow -->
  <ellipse cx="300" cy="230" rx="220" ry="180" fill="#3d6fca" opacity=".18" filter="url(#soft)"/>

  <!-- browser frame -->
  <rect x="70" y="46" width="420" height="330" rx="16" fill="#0e2140" stroke="rgba(255,255,255,.12)"/>
  <rect x="70" y="46" width="420" height="38" rx="16" fill="#132a52"/>
  <rect x="70" y="66" width="420" height="18" fill="#132a52"/>
  <circle cx="94" cy="65" r="4.5" fill="#5a6padding"/>
  <circle cx="94" cy="65" r="4.5" fill="#6b7aa0"/>
  <circle cx="110" cy="65" r="4.5" fill="#6b7aa0" opacity=".6"/>
  <circle cx="126" cy="65" r="4.5" fill="#6b7aa0" opacity=".6"/>

  <!-- gallery grid blocks -->
  <rect x="94" y="106" width="180" height="130" rx="8" fill="url(#g1)"/>
  <rect x="286" y="106" width="180" height="60" rx="8" fill="url(#g2)"/>
  <rect x="286" y="176" width="86" height="60" rx="8" fill="#1b3560"/>
  <rect x="380" y="176" width="86" height="60" rx="8" fill="url(#g3)"/>
  <rect x="94" y="248" width="120" height="104" rx="8" fill="#1b3560"/>
  <rect x="226" y="248" width="120" height="104" rx="8" fill="url(#g3)"/>
  <rect x="358" y="248" width="108" height="104" rx="8" fill="url(#g2)"/>

  <!-- grid guide lines -->
  <g stroke="rgba(255,255,255,.28)" stroke-width="1" stroke-dasharray="4 5" class="vd-path">
    <line x1="278" y1="96" x2="278" y2="362"/>
    <line x1="94" y1="242" x2="466" y2="242"/>
    <line x1="218" y1="242" x2="218" y2="362"/>
    <line x1="350" y1="242" x2="350" y2="362"/>
  </g>

  <!-- callout 01 -->
  <circle cx="184" cy="171" r="15" fill="#0e2140" stroke="#3d6fca" stroke-width="1.6"/>
  <text x="184" y="176" text-anchor="middle" font-family="Poppins" font-size="12" font-weight="700" fill="#fff">01</text>

  <!-- callout 02 -->
  <circle cx="30" cy="242" r="15" fill="#0e2140" stroke="#3d6fca" stroke-width="1.6"/>
  <text x="30" y="247" text-anchor="middle" font-family="Poppins" font-size="12" font-weight="700" fill="#fff">02</text>
  <line x1="45" y1="242" x2="90" y2="242" stroke="rgba(255,255,255,.35)" stroke-width="1.4" stroke-dasharray="3 4"/>

  <!-- callout 03 -->
  <circle cx="530" cy="65" r="15" fill="#0e2140" stroke="#3d6fca" stroke-width="1.6"/>
  <text x="530" y="70" text-anchor="middle" font-family="Poppins" font-size="12" font-weight="700" fill="#fff">03</text>
  <line x1="515" y1="65" x2="492" y2="65" stroke="rgba(255,255,255,.35)" stroke-width="1.4" stroke-dasharray="3 4"/>
</svg>