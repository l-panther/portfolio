
---
import type { Mobile } from '../../types/mobile';

const base = import.meta.env.BASE_URL;

const {
  prevMobile,
  nextMobile,
} = Astro.props as {
  prevMobile: Mobile | null;
  nextMobile: Mobile | null;
};
---

<section class="next-project">
  <div class="wrap">

    {prevMobile && (
      <a
        href={`${base}mobile/${prevMobile.slug}/`}
        class="next-link reveal"
        data-direction="prev"
      >
        <span>&larr;</span>
        {prevMobile.title}
      </a>
    )}

    {nextMobile && (
      <a
        href={`${base}mobile/${nextMobile.slug}/`}
        class="next-link reveal"
        data-direction="next"
      >
        {nextMobile.title}
        <span>&rarr;</span>
      </a>
    )}

  </div>
</section>
