
---
import mobile from '../../data/mobile.json';
import type { MobileProject } from '../../types/mobile';

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;

const projects = mobile as MobileProject[];

const currentIndex = projects.findIndex(
  (project) => project.slug === currentSlug
);

const previous =
  currentIndex > 0 ? projects[currentIndex - 1] : null;

const next =
  currentIndex >= 0 && currentIndex < projects.length - 1
    ? projects[currentIndex + 1]
    : null;

const base = import.meta.env.BASE_URL;
---

<nav
  class="mobile-project-navigation wrap"
  aria-label="Mobile project navigation"
>
  <div class="mobile-project-navigation-links">

    {previous ? (
      <a
        href={`${base}mobile/${previous.slug}/`}
        class="mobile-project-nav-link previous"
      >
        <span>← Previous Project</span>
        <strong>{previous.title}</strong>
      </a>
    ) : (
      <span class="mobile-project-nav-empty"></span>
    )}

    {next ? (
      <a
        href={`${base}mobile/${next.slug}/`}
        class="mobile-project-nav-link next"
      >
        <span>Next Project →</span>
        <strong>{next.title}</strong>
      </a>
    ) : (
      <span class="mobile-project-nav-empty"></span>
    )}

  </div>

  <div class="mobile-footer-back">
    <a href={`${base}#projects`} class="mobile-back-link">
      ← Back to Projects
    </a>
  </div>
</nav>
