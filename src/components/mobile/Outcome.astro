---
import type { MobileProject } from '../../types/mobile';
import ProjectNavigation from './ProjectNavigation.astro';

const { project } = Astro.props as {
  project: MobileProject;
};

const base = import.meta.env.BASE_URL;

const hasApp = Boolean(
  project.link &&
  project.link.trim() !== '#' &&
  project.link.trim().toLowerCase() !== 'null'
);

const hasGithub = Boolean(
  project.github &&
  project.github.trim() !== '#' &&
  project.github.trim().toLowerCase() !== 'null'
);
---

<section class="mobile-outcome" id="outcome">

  <div class="split-grid">

    <!-- TECHNOLOGY USED -->
    <div class="reveal">
      <h2>Technology <span class="accent">Used</span></h2>

      {project.development?.map((paragraph) => (
        <p>{paragraph}</p>
      ))}

      {project.technologies?.length > 0 && (
        <>
          <p class="stack-intro">The core stack includes:</p>

          <div class="stack-icons">
            {project.technologies.map((technology) => (
              <div class="chip">
                <img
                  src={`${base}assets/images/technologies/${technology}.png`}
                  alt={`${technology} logo`}
                  title={technology}
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </>
      )}
    </div>

    <!-- THE OUTCOME -->
    <div class="outcome-col reveal">
      <h2>The <span class="accent">Outcome</span></h2>

      {project.outcome?.map((paragraph) => (
        <p>{paragraph}</p>
      ))}

      <div class="outcome-actions">

        {hasApp ? (
          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-fill"
          >
            View App
          </a>
        ) : (
          <span class="btn btn-disabled" aria-disabled="true">
            View App
          </span>
        )}

        {hasGithub ? (
          <a
            href={project.github}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline"
          >
            GitHub
          </a>
        ) : (
          <span class="btn btn-disabled" aria-disabled="true">
            GitHub
          </span>
        )}

      </div>
    </div>

  </div>

  <!-- PREVIOUS / NEXT NAVIGATION -->
  <nav
    class="mobile-project-navigation wrap"
    aria-label="Mobile project navigation"
  >

    <div class="mobile-project-navigation-links">

      {previous ? (
        <a
          href={`${base}mobile/${previous.slug}/`}
          class="mobile-project-nav-link previous"
        >
          <span>← Previous Project</span>
          <strong>{previous.title}</strong>
        </a>
      ) : (
        <span class="mobile-project-nav-empty"></span>
      )}

      {next ? (
        <a
          href={`${base}mobile/${next.slug}/`}
          class="mobile-project-nav-link next"
        >
          <span>Next Project →</span>
          <strong>{next.title}</strong>
        </a>
      ) : (
        <span class="mobile-project-nav-empty"></span>
      )}

    </div>

    <ProjectNavigation currentSlug={project.slug} />

    <!-- BACK TO PORTFOLIO -->
    <div class="mobile-footer-back">
      <a href={`${base}#projects`} class="mobile-back-link">
        ← Back to Projects
      </a>
    </div>

  </nav>

</section>
