---
import type { MobileProject } from '../../types/mobile';
import ProjectNavigation from './ProjectNavigation.astro';

const { project } = Astro.props as {
  project: MobileProject;
};

const base = import.meta.env.BASE_URL;

const hasApp = Boolean(
  project.link &&
  project.link.trim() !== '#' &&
  project.link.trim().toLowerCase() !== 'null'
);

const hasGithub = Boolean(
  project.github &&
  project.github.trim() !== '#' &&
  project.github.trim().toLowerCase() !== 'null'
);
---

<section class="mobile-outcome" id="outcome">

  <div class="split-grid">

    <!-- TECHNOLOGY USED -->
    <div class="reveal">
      <h2>Technology <span class="accent">Used</span></h2>

      {project.development?.map((paragraph) => (
        <p>{paragraph}</p>
      ))}

      {project.technologies?.length > 0 && (
        <>
          <p class="stack-intro">The core stack includes:</p>

          <div class="stack-icons">
            {project.technologies.map((technology) => (
              <div class="chip">
                <img
                  src={`${base}assets/images/technologies/${technology}.png`}
                  alt={`${technology} logo`}
                  title={technology}
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </>
      )}
    </div>

    <!-- THE OUTCOME -->
    <div class="outcome-col reveal">
      <h2>The <span class="accent">Outcome</span></h2>

      {project.outcome?.map((paragraph) => (
        <p>{paragraph}</p>
      ))}

      <div class="outcome-actions">

        {hasApp ? (
          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-fill"
          >
            View App
          </a>
        ) : (
          <span class="btn btn-disabled" aria-disabled="true">
            View App
          </span>
        )}

        {hasGithub ? (
          <a
            href={project.github}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline"
          >
            GitHub
          </a>
        ) : (
          <span class="btn btn-disabled" aria-disabled="true">
            GitHub
          </span>
        )}

      </div>
    </div>

  </div>

  <!-- PROJECT NAVIGATION -->
  <ProjectNavigation currentSlug={project.slug} />

</section>
