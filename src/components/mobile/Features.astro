
---
import type { MobileProject } from '../../types/mobile';

const { project } = Astro.props as {
  project: MobileProject;
};
---

<section class="mobile-features" id="features">
  <div class="wrap">

    <div class="sec-head reveal">
      <span class="eyebrow">Application Design</span>

      <h2>
        Design <span class="accent">Highlights</span>
      </h2>
    </div>

    <div class="mobile-features-grid">
      {(project.designPoints ?? []).map((point, index) => (
        <article class="mobile-feature-card reveal">

          <span class="feature-number">
            {String(index + 1).padStart(2, '0')}
          </span>

          <h3>{point.title}</h3>
          <p>{point.text}</p>

        </article>
      ))}
    </div>

  </div>
</section>
