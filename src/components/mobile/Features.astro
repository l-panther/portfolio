---
import type { Mobile } from '../../types/mobile';

const { project } = Astro.props as {
  project: Mobile;
};
---

<section class="mobile-features" id="design">
  <div class="wrap">

    <div class="sec-head reveal">
      <span class="eyebrow">Application Design</span>
      <h2>Design <span class="accent">Highlights</span></h2>
    </div>

    <div class="mobile-design-layout">

      <div class="mobile-design-points">
        {project.designPoints?.map((point, index) => (
          <div class="mobile-design-point reveal">
            <span class="feature-number">
              {String(index + 1).padStart(2, '0')}
            </span>

            <div>
              <h3>{point.title}</h3>
              <p>{point.text}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="mobile-design-visual reveal">
        <div class="mobile-device-placeholder">
          <span class="device-icon" aria-hidden="true">▯</span>
          <span>Mobile Interface Preview</span>
        </div>
      </div>

    </div>

    <div class="mobile-design-approach reveal">
      <span class="eyebrow">Interface & User Experience</span>
      <h2>Design <span class="accent">Approach</span></h2>

      {project.design?.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>

  </div>
</section>


<style>

/* =========================================================
   DESIGN & FEATURES
========================================================= */

.mobile-design-layout {
  display: grid;
  grid-template-columns: 1.1fr .9fr;
  align-items: center;
  gap: 65px;
}

.mobile-design-points {
  display: flex;
  flex-direction: column;
  gap: 28px;
}

.mobile-design-point {
  display: grid;
  grid-template-columns: 55px minmax(0, 1fr);
  gap: 22px;
  align-items: start;
}

.mobile-design-point .feature-number {
  color: var(--blue-bright2);
  font-size: 32px;
  font-weight: 800;
  line-height: 1.2;
}

.mobile-design-point > div {
  padding-bottom: 25px;
  border-bottom: 1px solid rgba(255,255,255,.2);
}

.mobile-design-point h3 {
  margin: 0 0 10px;
  color: #fff;
  font-size: 15px;
  text-transform: uppercase;
}

.mobile-design-point p {
  margin: 0;
  color: #c3cddd;
  font-size: 14px;
  line-height: 1.8;
}

.mobile-design-approach {
  display: block;
  max-width: 760px;
  margin: 75px auto 0;
  padding-top: 55px;
  border-top: 1px solid rgba(255,255,255,.2);
  text-align: center;
}

.mobile-design-approach p {
  color: #c3cddd;
  font-size: 15px;
  line-height: 1.9;
}

@media (max-width: 900px) {
  .mobile-design-layout {
    grid-template-columns: 1fr;
    gap: 40px;
  }
}

@media (max-width: 600px) {
  .mobile-design-point {
    grid-template-columns: 42px minmax(0, 1fr);
    gap: 15px;
  }

  .mobile-design-approach {
    margin-top: 55px;
    padding-top: 40px;
  }
}


/* =========================================================
   DESIGN SECTION — MAIN STYLING
========================================================= */

.mobile-features {
  padding: 100px 24px;
  background: linear-gradient(
    155deg,
    var(--navy),
    var(--navy-deep)
  );
  color: #fff;
}

.mobile-features .sec-head {
  max-width: 760px;
  margin: 0 auto 65px;
  text-align: center;
}

.mobile-features .eyebrow {
  color: #a9c6e4;
}

.mobile-features h2 {
  margin: 0 0 25px;
  color: #fff;
  font-size: clamp(27px, 3.5vw, 38px);
  font-weight: 800;
  text-transform: uppercase;
}

.mobile-features .accent {
  color: var(--blue-bright2);
}

/* =========================================================
   DESIGN VISUAL
========================================================= */

.mobile-design-visual {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.mobile-device-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;

  width: 100%;
  min-height: 320px;
  padding: 30px;

  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: var(--radius);

  color: #a9c6e4;
  font-size: 12px;
  text-align: center;
}

.device-icon {
  color: var(--blue-bright2);
  font-size: 65px;
  line-height: 1;
}

/* =========================================================
   DESIGN SECTION — RESPONSIVE
========================================================= */

@media (max-width: 900px) {
  .mobile-features {
    padding: 80px 24px;
  }

  .mobile-device-placeholder {
    min-height: 250px;
  }
}

@media (max-width: 600px) {
  .mobile-features {
    padding: 65px 18px;
  }

  .mobile-features .sec-head {
    margin-bottom: 45px;
  }

  .mobile-features h2 {
    font-size: 24px;
  }

  .mobile-device-placeholder {
    min-height: 200px;
  }

  .mobile-design-point p,
  .mobile-design-approach p {
    font-size: 14px;
  }
}
</style>
