---
import type { MobileProject } from '../../types/mobile';

const { project } = Astro.props as {
  project: MobileProject;
};
---

<section class="mobile-features" id="design">
  <div class="wrap">

    <div class="sec-head reveal">
      <span class="eyebrow">Application Design</span>
      <h2>Design <span class="accent">Highlights</span></h2>
    </div>

    <div class="mobile-design-layout">

      <div class="mobile-design-points">
        {project.designPoints?.map((point, index) => (
          <div class="mobile-design-point reveal">
            <span class="feature-number">
              {String(index + 1).padStart(2, '0')}
            </span>

            <div>
              <h3>{point.title}</h3>
              <p>{point.description}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="mobile-design-visual reveal">
        <div class="mobile-device-placeholder">
          <span class="device-icon" aria-hidden="true">▯</span>
          <span>Mobile Interface Preview</span>
        </div>
      </div>

    </div>

    <div class="mobile-design-approach reveal">
      <span class="eyebrow">Interface & User Experience</span>
      <h2>Design <span class="accent">Approach</span></h2>

      {project.design?.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>

  </div>
</section>
