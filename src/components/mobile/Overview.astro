
---
import type { MobileProject } from '../../types/mobile';

const { project } = Astro.props as {
  project: MobileProject;
};
---

<section class="mobile-overview" id="overview">
  <div class="wrap">

    <div class="reveal">
      <span class="eyebrow">Project Overview</span>

      <h2>
        The <span class="accent">Challenge</span>
      </h2>

      <p class="project-statement">{project.statement}</p>

      {(project.problem ?? []).map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>

    <div class="reveal">
      <h2>
        The <span class="accent">Solution</span>
      </h2>

      {(project.solution ?? []).map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>

  </div>
</section>
